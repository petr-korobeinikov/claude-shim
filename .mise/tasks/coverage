#!/bin/sh
#MISE description="Test coverage: write codecov.json (for CI upload) and print a summary"
set -eu

# The glue files carry no unit tests, see openspec/config.yaml.
ignore='(^|/)(main|lib|dispatch|exec)\.rs$'
cargo llvm-cov --codecov --output-path target/codecov.json --ignore-filename-regex "$ignore"
cargo llvm-cov report --summary-only --ignore-filename-regex "$ignore"
